OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=real-time-ai-call-audit
OIDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----replace-with-secret-manager-value-----END PUBLIC KEY-----
CSRF_SECRET=replace-with-a-random-secret-at-least-32-bytes
ALLOWED_ORIGINS=["https://audit.example.com"]
DATABASE_URL=postgresql://call_audit:local-development-only@localhost:5432/call_audit
AUDIO_STORAGE_PATH=./private-audio
# Set FFPROBE to an approved local executable path for MP3 intake.
FFPROBE=ffprobe
FASTER_WHISPER_MODEL_PATH=D:/models/whisper-local
FASTER_WHISPER_MODEL_SHA256=replace-with-64-character-directory-sha256
FASTER_WHISPER_MODEL_VERSION=replace-with-exact-model-revision
FASTER_WHISPER_DEVICE=cpu
FASTER_WHISPER_COMPUTE_TYPE=int8
PRESIDIO_SPACY_MODEL_PATH=D:/models/spacy-local
PRESIDIO_SPACY_MODEL_SHA256=replace-with-64-character-directory-sha256
