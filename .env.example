OIDC_ISSUER=https://identity.example.com
OIDC_AUDIENCE=real-time-ai-call-audit
OIDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----replace-with-secret-manager-value-----END PUBLIC KEY-----
ALLOWED_ORIGINS=["https://audit.example.com"]
